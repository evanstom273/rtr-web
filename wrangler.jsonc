// Cloudflare Workers deploy config: a static-assets-only Worker serving the Vite build.
// `npx wrangler deploy` runs the build first, then uploads dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rtr-web",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // A real 404 for missing files. With SPA handling, a stale page asking for an old hashed bundle
    // got index.html back (200, text/html), the module failed to load and the screen stayed blank.
    // The app only lives at /, and the service worker handles offline navigation itself.
    "not_found_handling": "none"
  }
}
